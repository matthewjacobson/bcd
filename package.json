{
  "name": "@matthewjacobson/bcd",
  "version": "0.2.0",
  "description": "Boustrophedon cellular decomposition of polygons (with holes) along an arbitrary sweep angle.",
  "type": "module",
  "author": "Matthew Jacobson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthewjacobson/bcd.git"
  },
  "bugs": {
    "url": "https://github.com/matthewjacobson/bcd/issues"
  },
  "homepage": "https://github.com/matthewjacobson/bcd#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "demo": "npm run build && python3 -m http.server 8123",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "boustrophedon",
    "cellular-decomposition",
    "coverage-path-planning",
    "polygon",
    "robotics",
    "computational-geometry"
  ],
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
